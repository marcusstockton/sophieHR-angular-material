{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Edge",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}",
      "userDataDir": true
    },
    {
      "name": "Launch Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "preLaunchTask": "ng serve",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}",
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile",
      "runtimeArgs": [
        "--disable-cache",
        "--disable-extensions"
      ],
      "skipFiles": [
        "${workspaceFolder}/node_modules/**"
      ]
    },
    {
      "name": "Launch Firefox",
      "type": "firefox",
      "request": "launch",
      "preLaunchTask": "ng serve",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}",
      "reAttach": true,
      "skipFiles": [
        "${workspaceFolder}/node_modules/**"
      ]
    },
    {
      "name": "ng test",
      "type": "pwa-chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:9876/debug.html",
      "webRoot": "${workspaceFolder}"
    }
  ]
}